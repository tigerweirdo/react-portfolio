# Bu dosyayı ".env" olarak kopyalayın ve kendi değerlerinizi girin.
# UYARI: CRA'de REACT_APP_* ile başlayan her değişken derlenmiş JavaScript
# paketine GÖMÜLÜR ve herkes tarafından okunabilir. Buraya asla gerçek bir
# sır (admin şifresi, servis hesabı anahtarı, API secret) koymayın.
# Admin şifresi artık Firebase Authentication tarafında tutuluyor.

# Admin panelinin adresi: https://siteniz.com/<slug>
REACT_APP_ADMIN_SLUG=

# Firebase web app config (gizli değildir; koruma firestore.rules/storage.rules'tadır)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
